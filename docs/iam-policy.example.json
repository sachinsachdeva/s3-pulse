{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheFeedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "YOUR_PREFIX",
            "YOUR_PREFIX/*"
          ]
        }
      }
    },
    {
      "Sid": "DownloadFeedObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::YOUR_BUCKET/YOUR_PREFIX/*"
    }
  ]
}
